{
  "name": "@ranx729/medieval-ornaments",
  "version": "0.4.0",
  "description": "Categorized medieval ornaments with normalized frames, repeating dividers and whole decorations for JavaScript and React",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/medieval-ornaments.git"
  },
  "homepage": "https://adrian729.github.io/medieval-ornaments/",
  "bugs": {
    "url": "https://github.com/adrian729/medieval-ornaments/issues"
  },
  "keywords": [
    "medieval",
    "ornament",
    "border",
    "divider",
    "react",
    "vanilla",
    "decoration"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react-styled.js"
    },
    "./react/unstyled": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js"
    },
    "./styles.css": {
      "types": "./lib/styles.d.ts",
      "default": "./ornaments.css"
    },
    "./catalog.json": "./lib/catalog.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "medieval-ornaments": "lib/cli.js"
  },
  "files": [
    "lib",
    "ornaments.css",
    "docs/INTEGRATION.md",
    "docs/PERFORMANCE.md",
    "ASSET-RIGHTS.md",
    "SELECTION.md",
    "USAGE.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./lib/react-styled.js"
  ],
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-library.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "prepack": "node scripts/build-library.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit --strict --noUncheckedSideEffectImports --module nodenext --target es2022 --jsx react-jsx tests/types.tsx",
    "test:integration": "node tests/integration.mjs",
    "audit:performance": "node scripts/performance_audit.mjs",
    "build:assets": "node scripts/build-assets-package.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "ornamentAssets": {
    "package": "@ranx729/medieval-ornaments-assets",
    "version": "0.3.2"
  }
}
